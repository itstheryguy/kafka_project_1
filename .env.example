# Copy to .env (which is git-ignored) and fill in from Confluent Cloud:
# Cluster → Cluster settings → Bootstrap server; Cluster → API keys → Create key
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
KAFKA_API_KEY=
KAFKA_API_SECRET=
KAFKA_ADT_TOPIC=adt_events
KAFKA_DETAILS_TOPIC=encounter_details
